{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@glaicer/supercode-autoinvoke-skill-gate",
  "version": "0.1.2",
  "description": "OpenCode plugin that hides Explicit-only skills (Claude Code, Codex, OpenCode v2 portable markers) from the model-facing <available_skills> catalog",
  "type": "module",
  "license": "MIT",
  "author": "Dmitrii Aronov <aronov.mml@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glaicer/supercode-autoinvoke-skill-gate.git"
  },
  "homepage": "https://github.com/Glaicer/supercode-autoinvoke-skill-gate#readme",
  "bugs": {
    "url": "https://github.com/Glaicer/supercode-autoinvoke-skill-gate/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "autoinvoke-skill-gate"
  ],
  "main": "./dist/gate.js",
  "exports": {
    ".": "./dist/gate.js",
    "./server": "./dist/gate.js",
    "./filter": "./dist/filter.js",
    "./policy": "./dist/policy.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check:package",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@types/node": "24.13.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=24",
    "opencode": ">=1.14.17 <2"
  }
}
